{
  "name": "tilt",
  "version": "1.0.0",
  "description": "TILT - a gravity puzzle for phones. You never move the blocks; you move the world.",
  "private": true,
  "scripts": {
    "audit": "node tools/audit.js",
    "probe": "node tools/probe.js",
    "forge": "node tools/forge.js",
    "qa": "node tools/qa.js",
    "test:render": "node tools/render-test.js",
    "test:recovery": "node tools/recovery-test.js",
    "test:expression": "node tools/expression-test.js",
    "test:analysis": "node tools/analysis-test.js",
    "test": "node tools/test.js && node tools/floe-test.js && node tools/quality-test.js && node tools/ice-test.js && node tools/analysis-test.js && node tools/duo-test.js && node tools/save-test.js && node tools/cracked-test.js",
    "serve": "node tools/serve.js",
    "campaign": "node tools/campaign.js",
    "levels:search": "node tools/floe-search.js",
    "levels:build": "node tools/floe-campaign.js",
